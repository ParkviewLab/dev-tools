#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Gary Frattarola <garyf@parkviewlab.ai>
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# back-merge-check — verify that a back-merge pull request into develop brings
# exactly the released state of main, and at most the open-cycle commit, and
# nothing else.
#
#   back-merge-check <base> <head> [<main-ref>] [<tag>]
#   back-merge-check --merge-tree <develop> <main-ref> <tag>
#
#   base      develop's commit the pull request is tested against. In a
#             pull_request job, the first parent of the synthetic merge GitHub
#             checks out (git rev-parse HEAD^1), which is the base tip GitHub
#             merged against; github.event.pull_request.base.sha is not
#             guaranteed to follow develop after the pull request is opened.
#   head      the pull request's head commit, github.event.pull_request.head.sha;
#             never HEAD, which is the synthetic merge, itself a merge commit
#             that is not on main.
#   main-ref  default origin/main; fetched with full history. Read from
#             refs/remotes/<main-ref>, else refs/heads/<main-ref>, so that a tag
#             of the same name cannot stand in for it; a name only a tag carries
#             is refused.
#   tag       the released tag the branch names (back-merge-<tag>), e.g. v1.2.3.
#             Tag mode: every commit the merge brings from main must be in the
#             tag or be that tag's changelog commit, `docs(changelog): <tag>
#             [skip ci]`, which modifies or adds CHANGELOG.md alone, as a plain
#             file (submodule ignore settings do not apply); and main's version must be
#             the tag's. The version guard's back-merge mode always passes it.
#
#   --merge-tree  prints, on its last line, the tree this check accepts for the
#             merge of a back-merge of <tag> whose parents are <develop> and
#             main: the automatic merge where it is clean, else, for a release
#             picked onto main, the merge of condition 3 below; where there is
#             none it exits 1, its last line giving the reason, which for a
#             conflict ends " conflicts in: " and the paths. git back-merge
#             builds the merge of a release picked onto main from it.
#
# `git back-merge` runs this on its own branch before it pushes, and, in a
# repository that has switched to merge commits, the version guard runs it in its
# back-merge mode, checked out from dev-tools at a pinned release, so both apply
# one rule. The conditions, all required:
#
#   1. The commits in base..head that are not reachable from main are exactly
#      one merge commit M, optionally followed by one commit C that is the head
#      and whose parent is M.
#   2. M has two parents; M^1 is an ancestor of base; M^2 is an ancestor of main.
#   3. The tree of M equals `git merge-tree --write-tree M^1 M^2`, and that
#      automatic merge is clean; a hand-resolved merge is refused. One case
#      differs: in tag mode, for a release picked onto main in a repository
#      whose version is in pyproject.toml or package.json, where that automatic
#      merge conflicts or differs from M's tree, the tree of M must equal the
#      automatic merge in which the project's version lines of M^1 and of the
#      merge base are first set to main's version V, and that merge must be
#      clean. M^1 and M^2 must then have exactly one merge base MB; MB' and D'
#      are MB and M^1 with those lines rewritten to V and nothing else changed,
#      built as commits in the object store through a temporary index, touching
#      no ref, index or working tree; and the merge is `git merge-tree
#      --write-tree --merge-base=MB' D' M^2`. The lines are exactly those
#      condition 4 treats as the project's own: the first version line of
#      pyproject.toml's [project] table; in uv.lock, the first version line of
#      the [[package]] block whose name is the project's PEP 503 name, read from
#      main's pyproject.toml; package.json's top-level version; and in
#      package-lock.json the root's version and packages[""]'s. Only the quoted
#      value changes (quote style, spacing, a CR line ending and a missing last
#      line feed are kept), and a file without such a line is left as it is.
#      A release is picked onto main when the first-parent segment of main that
#      it adds holds no promotion: walking the tag's first-parent line from the
#      tag's parent, the first commit that a release tag vX.Y.Z points at ends
#      the segment (the whole line where there is none), and the release is a
#      promotion when some merge commit in the segment has a second parent that
#      is an ancestor of M^1. A first release that main reached by a
#      fast-forward has no promotion commit, so it counts as picked; the
#      automatic merge, tried first, still passes it as before.
#   4. The version at M equals main's. Without C, the head's version equals
#      main's. C is admitted only where the version file is pyproject.toml or
#      package.json; a repository whose version is in VERSION.txt skips the open
#      cycle, so a C there is refused. With C, C changes only version lines, only
#      in the version file and its lockfile (neither added, deleted nor changed in
#      mode, and compared blob to blob), and only from main's version to the
#      next-patch placeholder that dev-tools' _sot.sh computes for it
#      (X.Y.(Z+1).dev0 for pyproject.toml, X.Y.(Z+1)-dev0 for package.json); a
#      lockfile that records the project's version moves with it, and each line
#      that changes is the project's own: the [project] table's version, the
#      top-level version of package.json, and in a lockfile the project's entry,
#      not a dependency's. Neither file may hold a NUL byte, and a submodule's
#      ignore setting hides no change.
#   5. In tag mode, as above.
#   6. A shallow repository is refused outright.
#
# Versions are read from the committed trees, as the version guard reads them.
# Exit 0 = pass, 1 = not a clean back-merge, 2 = usage or repository error; with
# --merge-tree, 0 = the tree is printed and 1 = there is none.
# Portable to bash 3.2 (macOS) and bash 5 (the ubuntu runners). Needs git 2.40
# or later, for `git merge-tree --merge-base`. See the handbook's releases.md
# and ci.md.

set -euo pipefail
export LC_ALL=C   # byte-wise awk comparisons: macOS awk compares strings with strcoll

usage() {
  echo "usage: back-merge-check <base> <head> [<main-ref>] [<tag>]"
  echo "       back-merge-check --merge-tree <develop> <main-ref> <tag>"
}
case "${1:-}" in -h|--help) usage; exit 0 ;; esac
MODE=check
if [ "${1:-}" = --merge-tree ]; then
  MODE=merge-tree; shift
  if [ $# -ne 3 ]; then usage >&2; exit 2; fi
  DEV_IN=$1; MAIN_REF=$2; TAG=$3
else
  if [ $# -lt 2 ] || [ $# -gt 4 ]; then usage >&2; exit 2; fi
  BASE_IN=$1; HEAD_IN=$2; MAIN_REF=${3:-origin/main}; TAG=${4:-}
fi

fail() { echo "FAIL: $*"; exit 1; }
die()  { echo "ERROR: $*" >&2; exit 2; }
ok()   { echo "  ok: $*"; }

git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"
[ "$(git rev-parse --is-shallow-repository)" = "false" ] \
  || die "shallow repository: ancestry and merge-base answers are unreliable; fetch full history (and do not re-fetch develop with --depth=1)"
if [ -n "$TAG" ]; then
  echo "$TAG" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$' || fail "'$TAG' is not a release tag vX.Y.Z"
fi

if [ "$MODE" = check ]; then
  BASE=$(git rev-parse --verify --quiet "$BASE_IN^{commit}") || die "base $BASE_IN is not a commit"
  HEAD_SHA=$(git rev-parse --verify --quiet "$HEAD_IN^{commit}") || die "head $HEAD_IN is not a commit"
else
  DEV=$(git rev-parse --verify --quiet "$DEV_IN^{commit}") || die "develop $DEV_IN is not a commit"
fi
# A bare name such as origin/main resolves through refs/tags before refs/remotes,
# so a tag of that name would stand in for main. The remote-tracking branch, then
# a local branch, is taken, and a name that only a tag carries is refused.
resolve_main() {  # $1 = main-ref; prints the ref to read main from
  local r
  for r in "refs/remotes/$1" "refs/heads/$1"; do
    if git rev-parse --verify --quiet "$r^{commit}" >/dev/null; then echo "$r"; return 0; fi
  done
  case "$(git rev-parse --symbolic-full-name "$1" 2>/dev/null || true)" in
    refs/tags/*) return 1 ;;
  esac
  echo "$1"
}
MAIN_FULL=$(resolve_main "$MAIN_REF") || die "main ref $MAIN_REF names a tag, not a branch"
MAIN=$(git rev-parse --verify --quiet "$MAIN_FULL^{commit}") || die "main ref $MAIN_REF not found"
short() { git rev-parse --short "$1"; }
TMPD=$(mktemp -d "${TMPDIR:-/tmp}/back-merge-check.XXXXXX") || die "cannot make a temporary directory"
trap 'rm -rf "$TMPD"' EXIT
case "$TMPD" in /*) ;; *) TMPD="$PWD/$TMPD" ;; esac   # absolute, for GIT_INDEX_FILE

# --- version reading, from committed trees, as the version guard reads them ---
# The same reading as _sot.sh's sot_kind_at and sot_read_at, copied rather than
# sourced: a workflow pin's floor rises only with a change to the pinned script's
# own file (the handbook's ci.md), so every change to this check's behaviour must
# be a change to this file.
# Every reader in a pipeline here reads to the end of its input. One that stops
# early (head -1, awk's exit, grep -q) can leave the writer, git show, to die of
# SIGPIPE once more than a pipe buffer remains, as it does in a real lockfile;
# under pipefail the pipeline then fails although its output was right.
sot_kind_at() {  # $1 = commit; the precedence of dev-tools' _sot.sh
  if   git cat-file -e "$1:pyproject.toml" 2>/dev/null; then echo pyproject
  elif git cat-file -e "$1:package.json"   2>/dev/null; then echo package
  elif git cat-file -e "$1:VERSION.txt"    2>/dev/null; then echo version-txt
  else echo none; fi
}
version_at() {  # $1 = commit, $2 = kind; prints nothing where there is no version line
  case "$2" in
    pyproject)   git show "$1:pyproject.toml" | awk '!f && /^version *=/{print; f=1}' | sed -E "s/^version *= *[\"']([^\"']*)[\"'].*/\\1/" ;;
    package)     git show "$1:package.json" | awk '!f && /"version" *:/{print; f=1}' | sed -E 's/.*"version" *: *"([^"]*)".*/\1/' ;;
    version-txt) git show "$1:VERSION.txt" | tr -d '[:space:]' ;;
  esac
}
version_file() {  # $1 = kind; a function, since bash 3.2 misparses a case inside $(...)
  case "$1" in
    pyproject) echo pyproject.toml ;;
    package)   echo package.json ;;
    *)         echo VERSION.txt ;;
  esac
}
placeholder_for() {  # $1 = plain X.Y.Z release version, $2 = kind; as _sot.sh's sot_dev_version "$1" patch
  local X Y Z
  echo "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || return 1
  IFS=. read -r X Y Z <<EOF
$1
EOF
  case "$2" in
    pyproject) echo "$X.$Y.$((Z+1)).dev0" ;;
    package)   echo "$X.$Y.$((Z+1))-dev0" ;;
    *)         return 1 ;;
  esac
}
project_name_at() {  # $1 = commit; the project's name in its pyproject.toml, as uv records
                     # it (PEP 503): lowercase, each run of - _ . as -
  git show "$1:pyproject.toml" | awk '!f && /^name *=/{print; f=1}' | sed -E "s/^name *= *[\"']([^\"']*)[\"'].*/\\1/" \
    | tr 'A-Z' 'a-z' | sed -E 's/[-_.]+/-/g'
}

# --- a release picked onto main (condition 3) ---
# The rule by which a release is picked onto main, in the same text as in
# git-back-merge (a test holds the two copies equal). A promotion found where
# there is none would let a version change that reached develop during a
# promotion pass unseen, so a question git cannot answer returns 2, never
# "picked".
release_promotion() {  # $1 = the tag's commit, $2 = develop's side; prints the newest
                       # merge of the release's first-parent segment of main whose second
                       # parent is an ancestor of $2 (its promotion), or nothing for a
                       # release picked onto main; returns 2 where git cannot answer
  local tags rel line prev="" merges m rc
  tags=$(git show-ref -d --tags) || return 2
  rel=$(printf '%s\n' "$tags" | sed 's/\^{}$//' \
        | awk '$2 ~ /^refs\/tags\/v[0-9]+[.][0-9]+[.][0-9]+$/ {printf " %s", $1} END {printf " "}') || return 2
  if git rev-parse --verify --quiet "$1^1" >/dev/null; then
    line=$(git rev-list --first-parent "$1^1") || return 2
    prev=$(printf '%s\n' "$line" | awk -v rel="$rel" '!f && NF && index(rel, " " $1 " ") {print $1; f=1}') || return 2
  fi
  merges=$(git rev-list --first-parent --merges "$1" ${prev:+"^$prev"}) || return 2
  for m in $merges; do
    rc=0; git merge-base --is-ancestor "$m^2" "$2" || rc=$?
    case "$rc" in
      0) echo "$m"; return 0 ;;
      1) ;;
      *) return 2 ;;
    esac
  done
  return 0
}
# The project's version lines of one file, set to V_PICK, the file written to
# standard output: exactly the lines condition 4 treats as the project's own.
# Only the quoted value changes; a line whose value is not one quoted string is
# left as it is, and so is a file without such a line.
set_version_lines() {  # $1 = the file's path in the repository, $2 = the file
  local eol
  eol=$(tail -c1 "$2" | wc -l | tr -d ' ')   # 1 where the file ends with a line feed
  awk -v kind="$1" -v val="$V_PICK" -v namel="name = \"$PROJ_MAIN\"" -v eol="$eol" -v sq="'" '
    function key(s) {   # a version line: its key and separator, in RSTART and RLENGTH
      if (kind ~ /json$/) return match(s, /^[[:space:]]*"version"[[:space:]]*:[[:space:]]*/)
      return match(s, /^[[:space:]]*"?version"?[[:space:]]*=[[:space:]]*/)
    }
    function setval(s,    q, rest, p, v) {   # after key(s): the quoted value set to val
      q = substr(s, RLENGTH + 1, 1)
      if (q != "\"" && (q != sq || kind ~ /json$/)) return s
      rest = substr(s, RLENGTH + 2); p = index(rest, q); v = substr(rest, 1, p - 1)
      if (p < 2 || index(v, "\"") || index(v, sq)) return s
      return substr(s, 1, RLENGTH + 1) val substr(rest, p)
    }
    { line = $0; t = line; sub(/\r$/, "", t) }
    kind == "pyproject.toml" {
      if (t ~ /^\[/) { h = t; sub(/[[:space:]]+$/, "", h); inproj = (h == "[project]") }
      else if (inproj && !done && key(line)) { line = setval(line); done = 1 }
    }
    kind == "uv.lock" {
      if (t ~ /^\[/) { inpkg = (t == "[[package]]"); own = 0; done = 0 }
      else if (inpkg && t == namel) own = 1
      else if (own && !done && key(line)) { line = setval(line); done = 1 }
    }
    kind ~ /json$/ {
      if ((k == "{" || (kind == "package-lock.json" && index(k, "\"\": {"))) && !(owner in seen) && key(line)) {
        line = setval(line); seen[owner] = 1
      }
      if (t ~ /\{[[:space:]]*$/) { k = t; sub(/[[:space:]]+$/, "", k); owner = FNR }
    }
    NR > 1 { printf "%s\n", out }
    { out = line }
    END { if (NR) { printf "%s", out; if (eol) printf "\n" } }
  ' "$2"
}
tmp_commit() {  # $1 = tree; prints a parentless commit of it, an input to git merge-tree
                # that no ref names. A fixed identity and date: a CI runner may have no
                # user configured, and nothing of it is kept.
  GIT_AUTHOR_NAME=back-merge-check GIT_AUTHOR_EMAIL=back-merge-check@invalid GIT_AUTHOR_DATE='@1000000000 +0000' \
  GIT_COMMITTER_NAME=back-merge-check GIT_COMMITTER_EMAIL=back-merge-check@invalid GIT_COMMITTER_DATE='@1000000000 +0000' \
    git commit-tree --no-gpg-sign -m "back-merge-check: the project's version lines set to $V_PICK" "$1"
}
normalise() {  # $1 = commit; sets NORMALISED to a commit whose tree is $1's with the
               # project's version lines set to V_PICK, or to $1 where none changes
  local f entry mode type oid path new tree changed=0 idx="$TMPD/norm-index"
  NORMALISED=$1
  GIT_INDEX_FILE="$idx" git read-tree "$1" || die "git read-tree failed"
  for f in $VFILES; do
    entry=$(git ls-tree "$1" -- "$f") || die "git ls-tree failed"
    [ -n "$entry" ] || continue
    read -r mode type oid path <<EOF
$entry
EOF
    case "$mode" in 100644|100755) ;; *) continue ;; esac
    git cat-file blob "$oid" > "$TMPD/norm-in"
    [ "$(tr -d '\000' < "$TMPD/norm-in" | wc -c)" -eq "$(wc -c < "$TMPD/norm-in")" ] \
      || fail "$f at $(short "$1"): a NUL byte in the file"
    set_version_lines "$f" "$TMPD/norm-in" > "$TMPD/norm-out" || die "awk failed setting the version lines of $f"
    if cmp -s "$TMPD/norm-in" "$TMPD/norm-out"; then continue; fi
    new=$(git hash-object -w --no-filters --stdin < "$TMPD/norm-out") || die "git hash-object failed"
    GIT_INDEX_FILE="$idx" git update-index --cacheinfo "$mode,$new,$f" || die "git update-index failed"
    changed=1
  done
  [ "$changed" = 1 ] || return 0
  tree=$(GIT_INDEX_FILE="$idx" git write-tree) || die "git write-tree failed"
  NORMALISED=$(tmp_commit "$tree") || die "git commit-tree failed"
}
plain_merge() {  # $1, $2 = the two sides; sets AUTO (the tree), AUTO_RC (0 clean, 1 conflicts)
                 # and AUTO_FILES (the conflicting paths)
  local out
  AUTO_RC=0; out=$(git merge-tree --write-tree --no-messages --name-only "$1" "$2") || AUTO_RC=$?
  [ "$AUTO_RC" -le 1 ] || die "git merge-tree failed ($AUTO_RC)"
  AUTO=${out%%$'\n'*}
  AUTO_FILES=$(printf '%s\n' "$out" | sed 1d | tr '\n' ' ' | sed 's/ $//')
}
picked_release() {  # $1 = develop's side, $2 = main's side; 0 where the merge of a release
                    # picked onto main applies, having set V_PICK and VFILES
  local tagc promo
  [ -n "$TAG" ] || return 1
  case "$KIND" in
    pyproject) VFILES="pyproject.toml uv.lock" ;;
    package)   VFILES="package.json package-lock.json" ;;
    *)         return 1 ;;
  esac
  [ "$(sot_kind_at "$1")" = "$KIND" ] && [ "$(sot_kind_at "$2")" = "$KIND" ] || return 1
  tagc=$(git rev-parse --verify --quiet "refs/tags/$TAG^{commit}") || return 1
  git merge-base --is-ancestor "$tagc" "$2" || return 1
  promo=$(release_promotion "$tagc" "$1") || die "git cannot read the first-parent line of main below $TAG"
  [ -z "$promo" ] || return 1
  [ -n "$V_MAIN" ] || fail "no version line in main's $(version_file "$KIND") ($(short "$MAIN")); the check reads the first version line, as the version guard does"
  [ "v$V_MAIN" = "$TAG" ] || fail "main's version $V_MAIN is not the tag's ($TAG)"
  V_PICK=$V_MAIN
}
normalised_merge() {  # $1 = develop's side, $2 = main's side; sets NORM to the tree, or
                      # NORM_WHY to the reason there is none
  local bases rc n mbp dp out
  NORM=""; NORM_WHY=""
  rc=0; bases=$(git merge-base --all "$1" "$2") || rc=$?
  [ "$rc" -le 1 ] || die "git merge-base failed ($rc)"
  n=$(printf '%s\n' "$bases" | grep -c . || true)
  if [ "$n" != 1 ]; then
    NORM_WHY="develop and main have $n merge bases, and the project's version lines can be set to main's against a single merge base only"
    return 0
  fi
  normalise "$bases"; mbp=$NORMALISED
  normalise "$1"; dp=$NORMALISED
  rc=0; out=$(git merge-tree --write-tree --no-messages --name-only --merge-base="$mbp" "$dp" "$2") || rc=$?
  [ "$rc" -le 1 ] || die "git merge-tree failed ($rc)"
  if [ "$rc" = 1 ]; then
    NORM_WHY="the merge with the project's version lines set to main's $V_PICK conflicts in: $(printf '%s\n' "$out" | sed 1d | tr '\n' ' ' | sed 's/ $//')"
    return 0
  fi
  NORM=${out%%$'\n'*}
}
read_versions() {  # $1 = the commit whose version file sets the kind (the head, or develop)
  KIND=$(sot_kind_at "$1")
  V_MAIN=$(version_at "$MAIN" "$KIND" || true)
  PROJ_MAIN=""
  [ "$KIND" != pyproject ] || PROJ_MAIN=$(project_name_at "$MAIN" || true)
}

# --- --merge-tree: the tree the check accepts for the merge ---
if [ "$MODE" = merge-tree ]; then
  echo "back-merge check --merge-tree: develop $(short "$DEV"), main $(short "$MAIN"), tag $TAG"
  read_versions "$DEV"
  plain_merge "$DEV" "$MAIN"
  if [ "$AUTO_RC" = 0 ]; then
    ok "the automatic merge of develop and main"
    echo "$AUTO"; exit 0
  fi
  if picked_release "$DEV" "$MAIN"; then
    normalised_merge "$DEV" "$MAIN"
    [ -z "$NORM_WHY" ] || fail "$NORM_WHY"
    ok "the automatic merge with the project's version lines of develop and the merge base set to main's $V_PICK (a release picked onto main)"
    echo "$NORM"; exit 0
  fi
  fail "the automatic merge of develop and main conflicts in: $AUTO_FILES"
fi

echo "back-merge check: base $(short "$BASE"), head $(short "$HEAD_SHA"), main $(short "$MAIN")${TAG:+, tag $TAG}"

# --- 1. what the pull request brings that main does not have ---
OFF=$(git rev-list --topo-order "$HEAD_SHA" --not "$BASE" "$MAIN")
N_OFF=$(printf '%s\n' "$OFF" | grep -c . || true)
MERGES=""
for c in $OFF; do
  np=$(git rev-list --parents -n1 "$c" | awk '{print NF-1}')
  [ "$np" -ge 2 ] && MERGES="$MERGES $c"
done
N_MERGES=$(echo $MERGES | wc -w | tr -d ' ')
[ "$N_MERGES" = 1 ] || fail "expected exactly one merge commit not on main in base..head, found $N_MERGES (commits not on main: $N_OFF)"
M=$(echo $MERGES)
C=""
if [ "$N_OFF" = 1 ]; then
  [ "$M" = "$HEAD_SHA" ] || fail "the merge commit is not the head"
elif [ "$N_OFF" = 2 ]; then
  [ "$M" != "$HEAD_SHA" ] || fail "a second commit not on main sits below the merge"
  C=$HEAD_SHA
  [ "$(git rev-list --parents -n1 "$C" | awk '{print NF-1}')" = 1 ] || fail "the commit after the merge is not a single-parent commit"
  [ "$(git rev-parse "$C^1")" = "$M" ] || fail "the commit after the merge does not follow it directly"
else
  fail "$N_OFF commits not on main in base..head; a back-merge brings one merge and at most one open-cycle commit"
fi
ok "commits not on main: merge $(short "$M")${C:+ and open-cycle commit $(short "$C")}"

# --- 2. the merge's parents ---
NP=$(git rev-list --parents -n1 "$M" | awk '{print NF-1}')
[ "$NP" = 2 ] || fail "merge $(short "$M") has $NP parents, expected 2"
P1=$(git rev-parse "$M^1"); P2=$(git rev-parse "$M^2")
git merge-base --is-ancestor "$P1" "$BASE" || fail "first parent $(short "$P1") is not on develop (not an ancestor of base)"
ok "first parent $(short "$P1") is an ancestor of base"
git merge-base --is-ancestor "$P2" "$MAIN" || fail "second parent $(short "$P2") is not on main"
ok "second parent $(short "$P2") is an ancestor of main"

# the version kind, main's version and the project's name, which the merge of a
# release picked onto main needs in condition 3 and condition 4 checks
read_versions "$HEAD_SHA"

# --- 3. the merge is exactly the automatic merge of its parents ---
plain_merge "$P1" "$P2"
TREE=$(git rev-parse "$M^{tree}")
if [ "$AUTO_RC" = 0 ] && [ "$AUTO" = "$TREE" ]; then
  ok "tree of the merge equals the automatic merge ($(git rev-parse --short "$TREE"))"
elif picked_release "$P1" "$P2"; then
  normalised_merge "$P1" "$P2"
  if [ -n "$NORM_WHY" ]; then
    if [ "$AUTO_RC" = 1 ]; then fail "the automatic merge of the parents conflicts; for a release picked onto main, $NORM_WHY: a hand-resolved back-merge needs a person's review"; fi
    fail "tree of $(short "$M") differs from the automatic merge of its parents; for a release picked onto main, $NORM_WHY"
  fi
  [ "$NORM" = "$TREE" ] || fail "tree of $(short "$M") differs from the automatic merge with the project's version lines of develop and the merge base set to main's $V_PICK (a release picked onto main): $(git diff --stat "$NORM" "$TREE" | tail -1)"
  ok "tree of the merge equals the automatic merge with the project's version lines of develop and the merge base set to main's $V_PICK (a release picked onto main)"
else
  [ "$AUTO_RC" = 0 ] || fail "the automatic merge of the parents conflicts: a hand-resolved back-merge needs a person's review"
  fail "tree of $(short "$M") differs from the automatic merge of its parents: $(git diff --stat "$AUTO" "$TREE" | tail -1)"
fi

# --- 5. tag mode: everything brought from main is released ---
if [ -n "$TAG" ]; then
  TAGC=$(git rev-parse --verify --quiet "refs/tags/$TAG^{commit}") || fail "tag $TAG does not exist"
  git merge-base --is-ancestor "$TAGC" "$P2" || fail "tag $TAG is not an ancestor of the merged main commit"
  for c in $(git rev-list "$P2" --not "$TAGC"); do
    s=$(git log -1 --format=%s "$c")
    # the raw diff: one entry, CHANGELOG.md modified or added as a plain file
    f=$(git diff-tree --no-commit-id -r --raw --no-abbrev --ignore-submodules=none "$c")
    case "$f" in
      *$'\n'*) f="" ;;
      ":100644 100644 "*" M	CHANGELOG.md"|":000000 100644 "*" A	CHANGELOG.md") ;;
      *) f="" ;;
    esac
    [ "$s" = "docs(changelog): $TAG [skip ci]" ] && [ -n "$f" ] \
      || fail "commit $(short "$c") ('$s') was pushed to main after $TAG and is not its changelog commit"
  done
  ok "every commit brought from main is in $TAG or is its changelog commit"
fi

# --- 4. versions ---
[ "$KIND" != none ] || die "no version file (pyproject.toml, package.json or VERSION.txt) at head"
V_M=$(version_at "$M" "$KIND" || true); V_HEAD=$(version_at "$HEAD_SHA" "$KIND" || true)
for pair in "main:$MAIN:$V_MAIN" "the merge:$M:$V_M" "head:$HEAD_SHA:$V_HEAD"; do
  IFS=: read -r where commit v <<EOF
$pair
EOF
  [ -n "$v" ] || fail "no version line in $where's $(version_file "$KIND") ($(short "$commit")); the check reads the first version line, as the version guard does"
done
if [ -n "$TAG" ]; then
  [ "v$V_MAIN" = "$TAG" ] || fail "main's version $V_MAIN is not the tag's ($TAG)"
fi
[ "$V_M" = "$V_MAIN" ] || fail "version at the merge ($V_M) is not main's ($V_MAIN)"
if [ -z "$C" ]; then
  [ "$V_HEAD" = "$V_MAIN" ] || fail "head version $V_HEAD is not main's $V_MAIN"
  ok "head version $V_HEAD equals main's"
  echo "PASS"; exit 0
fi

[ "$KIND" != version-txt ] \
  || fail "the open-cycle commit $(short "$C") is refused: a repository whose version is in VERSION.txt skips the open cycle, so its back-merge carries the merge alone"
WANT=$(placeholder_for "$V_MAIN" "$KIND") || fail "main's version $V_MAIN is not a plain X.Y.Z release version"
[ "$V_HEAD" = "$WANT" ] || fail "open-cycle version $V_HEAD is not main's next-patch placeholder $WANT"

case "$KIND" in
  pyproject) SOT=pyproject.toml; LOCK=uv.lock ;;
  package)   SOT=package.json;   LOCK=package-lock.json ;;
esac
# the project's name, which owns its lines in uv.lock
PROJ=""
if [ "$KIND" = pyproject ]; then
  PROJ=$(project_name_at "$C")
fi
# The open-cycle commit's changes are compared blob to blob, line by line: a
# version change adds and removes no line, so the lines of the two blobs pair by
# number, and no diff text is parsed, which a line beginning with --- or +++, a
# diff driver or an unusual file name could make ambiguous.
line_value() {  # $1 = a version line; prints its quoted value
  printf '%s\n' "$1" | sed -E "s/^[[:space:]]*\"?version\"?[[:space:]]*[=:][[:space:]]*[\"']([^\"']*)[\"'].*/\\1/"
}
compare_blobs() {  # $1 = path, $2 = its blob at M, $3 = its blob at C
  local f=$1 old="$TMPD/old" new="$TMPD/new" diffs n minus plus owner max pairs=0
  git cat-file blob "$2" > "$old"
  git cat-file blob "$3" > "$new"
  [ "$(tr -d '\000' < "$old" | wc -c)" -eq "$(wc -c < "$old")" ] && [ "$(tr -d '\000' < "$new" | wc -c)" -eq "$(wc -c < "$new")" ] \
    || fail "$f: a NUL byte in the file"
  [ "$(tail -c1 "$old")" = "$(tail -c1 "$new")" ] || fail "$f: the open-cycle commit changes the last line ending"
  diffs=$(awk 'FILENAME==ARGV[1]{a[FNR]=$0; na=FNR; next} {nb=FNR} FNR>na || (a[FNR] "") != ($0 "") {print FNR} END{if (nb+0!=na+0) print "count"}' "$old" "$new")
  case "$diffs" in *count*) fail "$f: the open-cycle commit adds or removes lines" ;; esac
  case "$f" in
    package-lock.json) max=2 ;;
    *) max=1 ;;
  esac
  for n in $diffs; do   # line numbers
    pairs=$((pairs+1))
    [ "$pairs" -le "$max" ] || fail "$f: more than $max version lines changed"
    minus=$(awk -v n="$n" 'FNR==n{print; exit}' "$old")
    plus=$(awk -v n="$n" 'FNR==n{print; exit}' "$new")
    [ "${minus//"$V_MAIN"/$WANT}" = "$plus" ] || fail "$f: line $n changes more than the version value"   # unquoted replacement: bash 3.2 would keep the quotes
    printf '%s\n' "$minus" | grep -E '^[[:space:]]*"?version"?[[:space:]]*[=:]' >/dev/null || fail "$f: line $n is not a version line"
    [ "$(line_value "$minus")" = "$V_MAIN" ] && [ "$(line_value "$plus")" = "$WANT" ] \
      || fail "$f: line $n does not change the version from $V_MAIN to $WANT"
    [ "$f" != "$LOCK" ] || LOCK_DIFFS="$LOCK_DIFFS $n"
    # a lockfile's changed line must be the project's own, not a dependency's
    case "$f" in
      pyproject.toml)
        owner=$(awk -v n="$n" '{sub(/\r$/, "")} /^\[/{h=$0; sub(/[[:space:]]+$/, "", h)} FNR==n{print h; exit}' "$new")
        [ "$owner" = "[project]" ] || fail "pyproject.toml: line $n is not the [project] table's version ($owner)" ;;
      package.json)
        owner=$(awk -v n="$n" 'FNR<n && /\{[[:space:]]*$/{k=$0; sub(/[[:space:]]+$/, "", k)} FNR==n{print k; exit}' "$new")
        [ "$owner" = "{" ] || fail "package.json: line $n is not the top-level version ($owner)" ;;
      uv.lock)
        owner=$(awk -v n="$n" '{sub(/\r$/, "")} /^\[/{h=$0} /^name = "/{nm=$0} FNR==n{print h " " nm; exit}' "$new")
        [ "$owner" = "[[package]] name = \"$PROJ\"" ] || fail "uv.lock: line $n is not in the $PROJ package block ($owner)" ;;
      package-lock.json)
        owner=$(awk -v n="$n" 'FNR<n && /\{[[:space:]]*$/{k=$0; sub(/[[:space:]]+$/, "", k)} FNR==n{print k; exit}' "$new")
        case "$owner" in
          '{'|*'"": {'*) ;;
          *) fail "package-lock.json: line $n is not the root package's version ($owner)" ;;
        esac ;;
    esac
  done
  [ "$pairs" -ge 1 ] || fail "$f: no version line changed"
}
# The files it changes, from the raw diff read NUL-delimited, which neither word
# splitting, globbing nor the quoting of an unusual name can alter.
CHANGED=""; SOT_CHANGED=0; LOCK_DIFFS=""
git diff --raw -z --no-abbrev --no-renames --ignore-submodules=none "$M" "$C" > "$TMPD/raw"
while IFS= read -r -d '' meta && IFS= read -r -d '' f; do
  IFS=' ' read -r om nm ob nb st <<EOF
$meta
EOF
  case "$f" in
    "$SOT"|"$LOCK") ;;
    *) fail "the open-cycle commit changes $(printf '%q' "$f")" ;;
  esac
  [ "$st" = M ] || fail "the open-cycle commit adds or deletes $f"
  [ "${om#:}" = "$nm" ] || fail "the open-cycle commit changes $f's mode (${om#:} -> $nm)"
  [ "$f" != "$SOT" ] || SOT_CHANGED=1
  CHANGED="$CHANGED $f"
  compare_blobs "$f" "$ob" "$nb"
done < "$TMPD/raw"
[ "$SOT_CHANGED" = 1 ] || fail "the open-cycle commit does not change $SOT"
# A lockfile that records the project's version must move with it: every line of
# the project's own that holds main's version at M must be among those C changes
# (in package-lock.json, the top-level version and packages[""]'s).
project_version_lines() {  # $1 = the lockfile at M; prints those lines' numbers
  case "$LOCK" in
    uv.lock)
      awk -v p="name = \"$PROJ\"" -v v="version = \"$V_MAIN\"" \
        '{sub(/\r$/, "")} /^\[/{h=$0; own=0} h=="[[package]]" && $0==p {own=1} own && $0==v {print FNR}' "$1" ;;
    package-lock.json)
      awk -v v="\"version\": \"$V_MAIN\"" \
        '(k=="{" || index(k, "\"\": {")) && index($0, v) {print FNR} /\{[[:space:]]*$/{k=$0; sub(/[[:space:]]+$/, "", k)}' "$1" ;;
  esac
}
if git cat-file -e "$M:$LOCK" 2>/dev/null; then
  git cat-file blob "$M:$LOCK" > "$TMPD/lock-at-m"
  for L in $(project_version_lines "$TMPD/lock-at-m"); do
    case "$LOCK_DIFFS " in
      *" $L "*) ;;
      *) fail "$LOCK still records $V_MAIN for the project at line $L; the open-cycle commit must update it with $SOT" ;;
    esac
  done
fi
ok "open-cycle commit $(short "$C") changes only the version, $V_MAIN -> $WANT (${CHANGED# })"
echo "PASS"
