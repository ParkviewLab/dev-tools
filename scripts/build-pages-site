#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 Gary Frattarola <garyf@parkviewlab.ai>
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Build a repository's GitHub Pages documentation site from released content.

Usage:
    build-pages-site --out DIR [--tag vX.Y.Z] [--shell FILE] [--repo DIR]

Assembles the site of the repository at --repo (default: the current directory)
into DIR, a new or empty directory:

    index.html      generated: the page shell around the introduction
                    (site/intro.html) and a list of the documents in docs/
    <page>/         every other file under site/, copied as it is, with the
                    release tag stamped into each .html in place of
                    __LATEST_TAG__ (site/intro.html and the shell file, when it
                    lives under site/, are not copied; a shell under docs/ is
                    refused, since it would be published as a document)
    docs/           docs/, byte-identical to the repository, plus a generated
                    index.html in any subfolder that holds documents

Only docs/ and site/ are read. Anything else at the repository root, such as a
checkout of dev-tools in a subfolder, is ignored; site/ is optional, as is the
introduction, and a repository with neither publishes its docs/ alone.

The release tag is --tag if given, else the newest v* tag reachable from HEAD
(git describe --tags --abbrev=0 --match 'v[0-9]*'); either way it must be a
vX.Y.Z release tag, so a vnext is refused. A tag reachable from HEAD may be
the previous release's rather than this one's: a run that starts before the tag
lands stamps the previous release and publishes, and a manual re-run on the
changelog commit that follows a release still builds. A repository with no v*
tag at all fails the build. Every GitHub link the build emits is pinned to that
tag, and the repository is read off the origin remote (GITHUB_REPOSITORY when
there is no remote to read). --repo must be the root of its git checkout when
it is inside one, so a subdirectory never borrows the enclosing checkout's
remote.

The document list groups, in order: the northstar (northstar.html if present,
else northstar.md); the other HTML documents; the Markdown specifications and
notes; the ideas under consideration (in-flight_ideas.md and *_ideas.md);
CONTRIBUTING.md. A Markdown file whose basename has an .html twin is listed
once, under the twin, with a "Markdown source" link. Within a group the order
is by title. Titles come from an HTML file's <title> or a Markdown file's first
"# " heading, descriptions from <meta name="description"> when present; a
document without a title fails the build. HTML documents are linked
relatively; Markdown documents, and the "Markdown source" links, go to
GitHub's rendered view pinned to the tag. Every other link is relative.

The page shell
--------------
The root index and every folder index are the shell with its placeholders
substituted. --shell FILE names it; without --shell the built-in default, in
the ParkviewLab brand, is used. The placeholders, of which {{groups}} is
required and the rest optional:

    {{title}}     the page title, escaped: the repository name on the root
                  page, "<repo> · docs/<folder>" on a folder index
    {{intro}}     site/intro.html without its leading comments, on the root
                  page; empty on a folder index, and when there is no intro
    {{groups}}    the document list: the groups above and, where the folder
                  has subfolders holding documents, a "Folders" group
    {{root}}      the relative path from the page's folder to the site root:
                  "" on the root page, "../../" in docs/<folder>/
    {{tag}}       the release tag, escaped
    {{repo}}      the repository name (the GitHub slug), escaped
    {{footer}}    two <span>s: the release the site is published from, linked
                  to its tree on GitHub, and a link to the repository

A placeholder that starts its line is indented to that line's column, every
line of a multi-line value with it, so the output follows the shell's own
layout. A placeholder is written exactly as listed: any other {{...}} in the
shell, a different case or spacing included, fails the build. The intro, the
groups and the footer are HTML fragments, inserted as they are. __LATEST_TAG__
is substituted in the shell and in the intro as well, so either form gives the
release tag.

After the stamp, a token still shaped like the tag placeholder fails the
build, in a hand-built page and in a generated one alike: two underscores at
one end and at least one at the other, with TAG or LATEST as one of the
underscore-separated parts of its name (a misspelt __LATEST_TAG_, a
__NEXT_TAG__). __FILE__ or __VERSION__ quoted in a page is not one, nor is the
partial '__LATEST' a script may test for.

After writing, every relative href, src and CSS url() in the generated and
stamped pages is resolved against DIR; the build fails, listing the missing
targets, if any does not resolve. The HTML documents copied from docs/ are
checked the same way but only reported: docs/ is published exactly as the
repository holds it, so a reference of its own that does not resolve is a
defect to fix in that document, not a reason to withhold the whole site.
Copied Markdown is not checked at all.

Standard library only. The contract and the guarantees are the handbook's
docs/docs-site.md.

Exit codes:
  0  success
  1  build failure (no tag, no docs/, an untitled or unreadable document, a
     placeholder surviving the stamp, an unresolved reference, an unusable
     --out, --shell or --repo, a folder index not spelt index.html, no
     repository to link to)
  2  bad arguments
"""

from __future__ import annotations

import argparse
import html
import os
import posixpath
import re
import shutil
import subprocess
import sys
import textwrap
from dataclasses import dataclass, field
from html.parser import HTMLParser
from pathlib import Path, PurePosixPath
from urllib.parse import quote, unquote, urlsplit

PROG = "build-pages-site"

TAG_PLACEHOLDER = "__LATEST_TAG__"
# After the stamp, a token still shaped like the tag placeholder is one that
# was misspelt or never substituted; it fails the build rather than going
# public. The shape: two underscores at one end and at least one at the other,
# with TAG or LATEST as one of the underscore-separated parts of the name.
# __FILE__ or __VERSION__ quoted in a page is not one, nor is the partial
# '__LATEST' a script may test for.
SURVIVOR_RE = re.compile(
    r"(?<![A-Za-z0-9_])(?:__(?:[A-Z0-9]+_)*(?:TAG|LATEST)(?:_[A-Z0-9]+)*_+"
    r"|_+(?:[A-Z0-9]+_)*(?:TAG|LATEST)(?:_[A-Z0-9]+)*__)(?![A-Za-z0-9_])"
)
TAG_RE = re.compile(r"v\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.+-]+)?")
DOC_SUFFIXES = (".html", ".md")

# The five groups, in the order they are listed. The key is also the CSS class
# that picks the group's accent colour.
GROUPS = (
    ("northstar", "Northstar"),
    ("html", "HTML documents"),
    ("specs", "Specifications and notes"),
    ("ideas", "Ideas under consideration"),
    ("contributing", "Contributing"),
)

# The shell's placeholders. A placeholder that starts its line captures the
# line's indentation, which the substitution applies to every line of the value.
PLACEHOLDERS = ("title", "intro", "groups", "root", "tag", "repo", "footer")
PLACEHOLDER_RE = re.compile(r"(?:^([ \t]*))?\{\{([a-z]+)\}\}", re.MULTILINE)
# Anything between double braces; only the exact tokens above are placeholders,
# and the rest fail the build rather than being published as they are.
LOOSE_PLACEHOLDER_RE = re.compile(r"\{\{[^{}]*\}\}")


class BuildError(Exception):
    """A condition that must fail the build, with a message for the log."""


def read_utf8(path: Path, label: str) -> str:
    """The file's text, a byte-order mark dropped; a build error when unreadable."""
    try:
        return path.read_text(encoding="utf-8-sig")
    except UnicodeDecodeError as e:
        raise BuildError(f"{label} is not UTF-8: {e}") from None
    except OSError as e:
        raise BuildError(f"{label} cannot be read: {e}") from None


# --------------------------------------------------------------------------- #
# The repository
# --------------------------------------------------------------------------- #

REMOTE_RE = re.compile(r"github\.com[:/](?P<owner>[^/:]+)/(?P<name>[^/]+?)(?:\.git)?/?$")


@dataclass(frozen=True)
class Repository:
    root: Path
    owner: str
    name: str

    @property
    def github_url(self) -> str:
        return f"https://github.com/{self.owner}/{self.name}"

    @property
    def docs_dir(self) -> Path:
        return self.root / "docs"

    @property
    def site_dir(self) -> Path:
        return self.root / "site"

    @property
    def intro_file(self) -> Path:
        return self.site_dir / "intro.html"


def git_output(root: Path, *args: str) -> str:
    """Stdout of a git command run in root, or "" when it fails or git is absent."""
    try:
        result = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True, check=False)
    except OSError:
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


def repository(root_arg: str) -> Repository:
    root = Path(root_arg).resolve()
    if not root.is_dir():
        raise BuildError(f"--repo {root_arg}: not a directory")
    top = git_output(root, "rev-parse", "--show-toplevel")
    if top and Path(top).resolve() != root:
        raise BuildError(f"--repo {root_arg} is inside the checkout at {top} but is not its root; pass the root")
    m = REMOTE_RE.search(git_output(root, "remote", "get-url", "origin"))
    if m:
        return Repository(root, m["owner"], m["name"])
    slug = os.environ.get("GITHUB_REPOSITORY", "")
    if slug.count("/") == 1 and all(slug.split("/")):
        owner, name = slug.split("/")
        return Repository(root, owner, name)
    raise BuildError(
        "cannot tell which GitHub repository this is: no github.com origin remote "
        "to read, and GITHUB_REPOSITORY is not set"
    )


def release_tag(explicit: str | None, root: Path) -> str:
    if explicit is not None:
        if not TAG_RE.fullmatch(explicit):
            raise BuildError(f"--tag {explicit!r} is not a vX.Y.Z tag")
        return explicit
    tag = git_output(root, "describe", "--tags", "--abbrev=0", "--match", "v[0-9]*")
    if not tag:
        raise BuildError(
            "no v* tag reachable from HEAD (git describe --tags --abbrev=0 --match 'v[0-9]*'); "
            "refusing to publish a site with no release to pin to"
        )
    if not TAG_RE.fullmatch(tag):
        raise BuildError(f"the newest v* tag reachable from HEAD, {tag!r}, is not a vX.Y.Z release tag")
    return tag


# --------------------------------------------------------------------------- #
# The documents
# --------------------------------------------------------------------------- #


@dataclass
class Document:
    rel: PurePosixPath  # path relative to docs/
    kind: str  # "html" or "md"
    title: str  # entities decoded; escaped again on output
    description: str | None = None
    twin: Document | None = None  # the Markdown twin of an HTML document

    @property
    def stem(self) -> str:
        return self.rel.stem

    @property
    def sort_key(self) -> tuple[str, str]:
        return (self.title.casefold(), str(self.rel))


@dataclass
class Folder:
    rel: PurePosixPath  # relative to docs/; "." for docs/ itself
    documents: list[Document] = field(default_factory=list)
    subfolders: list[Folder] = field(default_factory=list)
    has_own_index: bool = False  # the repository ships docs/<rel>/index.html
    index_clash: list[str] = field(default_factory=list)  # an Index.html or the like: not an index to Pages

    @property
    def holds_documents(self) -> bool:
        return bool(self.documents) or any(f.holds_documents for f in self.subfolders)


class HeadScanner(HTMLParser):
    """Collects an HTML document's <title> text and description meta.

    The title is the first <title> element; a later one (an inline <svg>'s,
    say) is not appended to it. Scanning stops at </head> or at <body>,
    whichever comes first.
    """

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.title_parts: list[str] = []
        self.description: str | None = None
        self._in_title = False
        self._title_done = False
        self._done = False

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if self._done:
            return
        if tag == "title":
            self._in_title = not self._title_done
        elif tag == "meta" and self.description is None:
            a = dict(attrs)
            if (a.get("name") or "").strip().lower() == "description" and a.get("content"):
                self.description = normalise_ws(a["content"] or "")
        elif tag == "body":
            self._done = True

    def handle_endtag(self, tag: str) -> None:
        if tag == "title":
            if self._in_title:
                self._title_done = True
            self._in_title = False
        elif tag == "head":
            self._done = True

    def handle_data(self, data: str) -> None:
        if self._in_title and not self._done:
            self.title_parts.append(data)

    @property
    def title(self) -> str:
        return normalise_ws("".join(self.title_parts))


def normalise_ws(text: str) -> str:
    return " ".join(text.split())


def html_head(path: Path, label: str | None = None) -> tuple[str, str | None]:
    scanner = HeadScanner()
    scanner.feed(read_utf8(path, label or str(path)))
    scanner.close()
    return scanner.title, scanner.description


FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
H1_RE = re.compile(r"^ {0,3}#[ \t]+(.*?)(?:[ \t]+#+)?[ \t]*$")


def markdown_title(path: Path, label: str | None = None) -> str:
    """The text of the first "# " heading, skipping fenced code blocks."""
    fence: str | None = None
    for line in read_utf8(path, label or str(path)).splitlines():
        m = FENCE_RE.match(line)
        if m:
            marker = m.group(1)[0]
            if fence is None:
                fence = marker
            elif marker == fence:
                fence = None
            continue
        if fence:
            continue
        m = H1_RE.match(line)
        if m:
            return normalise_ws(m.group(1))
    return ""


def scan_folder(docs_dir: Path, rel: PurePosixPath, untitled: list[str]) -> Folder:
    """Read the documents directly in docs/<rel>, pair twins, and recurse."""
    folder = Folder(rel=rel)
    here = docs_dir / rel
    entries = sorted(here.iterdir(), key=lambda p: p.name)
    by_name: dict[str, Document] = {}
    for p in entries:
        if not p.is_file() or p.suffix.lower() not in DOC_SUFFIXES:
            continue
        doc_rel = rel / p.name if str(rel) != "." else PurePosixPath(p.name)
        if p.suffix.lower() == ".html":
            title, description = html_head(p, f"docs/{doc_rel}")
            doc = Document(doc_rel, "html", title, description)
        else:
            doc = Document(doc_rel, "md", markdown_title(p, f"docs/{doc_rel}"))
        if not doc.title:
            untitled.append(str(doc_rel))
        by_name[p.name] = doc
    for doc in by_name.values():
        if doc.kind == "html":
            twin = by_name.get(doc.stem + ".md")
            if twin is not None:
                doc.twin = twin
    twins = {id(d.twin) for d in by_name.values() if d.twin is not None}
    folder.documents = [d for d in by_name.values() if id(d) not in twins]
    folder.has_own_index = "index.html" in by_name
    folder.index_clash = sorted(n for n in by_name if n.casefold() == "index.html" and n != "index.html")
    for p in entries:
        if p.is_dir():
            sub_rel = rel / p.name if str(rel) != "." else PurePosixPath(p.name)
            sub = scan_folder(docs_dir, sub_rel, untitled)
            if sub.holds_documents:
                folder.subfolders.append(sub)
    return folder


def group_of(doc: Document) -> str:
    if doc.kind == "html":
        return "northstar" if doc.stem == "northstar" else "html"
    # A Markdown document without an HTML twin.
    if doc.stem == "northstar":
        return "northstar"
    if doc.stem.lower() == "contributing":
        return "contributing"
    if doc.stem.endswith("_ideas"):  # in-flight_ideas.md and every *_ideas.md
        return "ideas"
    return "specs"


