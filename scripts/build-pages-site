  </div>

  <div class="section-label">documents · {{tag}}</div>
  <p class="docs-lede">HTML documents open here; Markdown documents open in GitHub's rendered view at {{tag}}.</p>
  {{groups}}

  <footer class="site">
    {{footer}}
  </footer>

</div>
</body>
</html>
"""


@dataclass(frozen=True)
class Shell:
    text: str
    path: Path | None  # None for the built-in default

    @property
    def label(self) -> str:
        return str(self.path) if self.path is not None else "the built-in shell"


def load_shell(arg: str | None) -> Shell:
    if arg is None:
        shell = Shell(DEFAULT_SHELL, None)
    else:
        path = Path(arg)
        if not path.is_file():
            raise BuildError(f"--shell {arg}: no such file")
        shell = Shell(path.read_text(encoding="utf-8"), path.resolve())
    names = {m.group(2) for m in PLACEHOLDER_RE.finditer(shell.text)}
    unknown = sorted(names - set(PLACEHOLDERS))
    if unknown:
        raise BuildError(
            f"{shell.label}: unknown placeholder {', '.join('{{' + n + '}}' for n in unknown)}; "
            f"the set is {', '.join('{{' + n + '}}' for n in PLACEHOLDERS)}"
        )
    if "groups" not in names:
        raise BuildError(f"{shell.label} has no {{{{groups}}}} placeholder; the document list has nowhere to go")
    return shell


def fill(shell: Shell, values: dict[str, str]) -> str:
    """The shell with its placeholders substituted, each indented to its line."""

    def replace(m: re.Match[str]) -> str:
        indent, name = m.group(1), m.group(2)
        value = values[name]
        return value if indent is None else textwrap.indent(value, indent)

    return PLACEHOLDER_RE.sub(replace, shell.text)


def esc(text: str) -> str:
    return html.escape(text, quote=True)


def github_blob(repo: Repository, tag: str, rel: PurePosixPath) -> str:
    return f"{repo.github_url}/blob/{tag}/docs/{quote(str(rel), safe='/')}"


def render_document(doc: Document, repo: Repository, tag: str, page_dir: str) -> str:
    """One card. page_dir is the page's folder relative to the site root."""
    if doc.kind == "html":
        href = posixpath.relpath(f"docs/{doc.rel}", page_dir)
    else:
        href = github_blob(repo, tag, doc.rel)
    lines = [f'  <li class="doc"><a class="doc-title" href="{esc(href)}">{esc(doc.title)}</a>']
    if doc.description:
        lines.append(f'    <p class="doc-desc">{esc(doc.description)}</p>')
    if doc.kind == "md":
        lines.append('    <p class="doc-meta">Markdown · rendered on GitHub</p>')
    elif doc.twin is not None:
        src = github_blob(repo, tag, doc.twin.rel)
        lines.append(f'    <p class="doc-meta"><a href="{esc(src)}">Markdown source</a></p>')
    lines.append("  </li>")
    return "\n".join(lines)


def render_groups(folder: Folder, repo: Repository, tag: str, page_dir: str) -> tuple[str, dict[str, int]]:
    """The group sections for one folder, and a count of documents per group."""
    grouped: dict[str, list[Document]] = {key: [] for key, _ in GROUPS}
    for doc in folder.documents:
        grouped[group_of(doc)].append(doc)
    counts = {key: len(docs) for key, docs in grouped.items()}
    sections: list[str] = []
    for key, heading in GROUPS:
        docs = sorted(grouped[key], key=lambda d: d.sort_key)
        if not docs:
            continue
        cards = "\n".join(render_document(d, repo, tag, page_dir) for d in docs)
        sections.append(
            f'<div class="group {key}">\n  <h3>{esc(heading)}</h3>\n'
            f'  <ul class="doclist">\n{cards}\n  </ul>\n</div>'
        )
    if folder.subfolders:
        cards = []
        for sub in sorted(folder.subfolders, key=lambda f: str(f.rel).casefold()):
            href = posixpath.relpath(f"docs/{sub.rel}", page_dir) + "/"
            cards.append(f'  <li class="doc"><a class="doc-title" href="{esc(href)}">{esc(sub.rel.name)}/</a></li>')
        sections.append(
            '<div class="group folders">\n  <h3>Folders</h3>\n'
            '  <ul class="doclist">\n' + "\n".join(cards) + "\n  </ul>\n</div>"
        )
    return "\n".join(sections), counts


LEADING_COMMENTS_RE = re.compile(r"\A(?:\s*<!--.*?-->)*\s*", re.DOTALL)


def read_intro(repo: Repository) -> str:
    """site/intro.html without its leading comments; "" when there is none."""
    if not repo.intro_file.is_file():
        return ""
    text = LEADING_COMMENTS_RE.sub("", repo.intro_file.read_text(encoding="utf-8")).rstrip()
    if not text:
        raise BuildError("site/intro.html holds no introduction; delete it to publish without one")
    return text


def render_footer(repo: Repository, tag: str) -> str:
    return (
        f'<span>Published from <a href="{esc(repo.github_url)}/tree/{esc(tag)}">{esc(tag)}</a></span>\n'
        f'<span><a href="{esc(repo.github_url)}">{esc(repo.owner)}/{esc(repo.name)} on GitHub</a></span>'
    )


def render_page(
    shell: Shell, repo: Repository, tag: str, folder: Folder, intro: str
) -> tuple[str, dict[str, int]]:
    """The root index (folder.rel == ".") or a folder index, and its group counts."""
    if str(folder.rel) == ".":
        title, root, page_dir = repo.name, "", "."
    else:
        title = f"{repo.name} · docs/{folder.rel}"
        root = "../" * (len(folder.rel.parts) + 1)
        page_dir = f"docs/{folder.rel}"
    groups, counts = render_groups(folder, repo, tag, page_dir)
    values = {
        "title": esc(title),
        "intro": intro,
        "groups": groups,
        "root": root,
        "tag": esc(tag),
        "repo": esc(repo.name),
        "footer": render_footer(repo, tag),
    }
    return fill(shell, values), counts


# --------------------------------------------------------------------------- #
# The link check
# --------------------------------------------------------------------------- #

SCHEME_RE = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")
CSS_URL_RE = re.compile(r"""url\(\s*(['"]?)([^'")\s]+)\1\s*\)""")


class RefCollector(HTMLParser):
    """Collects every href and src attribute, and every url() inside <style>."""

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.refs: list[tuple[str, int]] = []
        self._in_style = False

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        line = self.getpos()[0]
        for name, value in attrs:
            if name in ("href", "src") and value is not None:
                self.refs.append((value.strip(), line))
        if tag == "style":
            self._in_style = True

    def handle_endtag(self, tag: str) -> None:
        if tag == "style":
            self._in_style = False

    def handle_data(self, data: str) -> None:
        if self._in_style:
            line = self.getpos()[0]
            for m in CSS_URL_RE.finditer(data):
                self.refs.append((m.group(2), line + data[: m.start()].count("\n")))


def is_local(ref: str) -> bool:
    """Whether a reference addresses a file of ours, rather than somewhere else."""
    if not ref or ref.startswith(("#", "//")) or SCHEME_RE.match(ref):
        return False  # a fragment, a protocol-relative or an absolute URL: not ours
    return bool(unquote(urlsplit(ref).path))  # false for a bare query or fragment


def unresolved(ref: str, page: Path, out: Path, repo_name: str) -> str | None:
    """Why a reference does not resolve to a file in out, or None if it does."""
    if not is_local(ref):
        return None
    path = unquote(urlsplit(ref).path)
    if path.startswith("/"):
        return f"root-relative; the site lives under /{repo_name}/, so every reference must be relative"
    target = (page.parent / path).resolve()
    try:
        target.relative_to(out)
    except ValueError:
        return "resolves outside the site"
    if path.endswith("/") or target.is_dir():
        return None if (target / "index.html").is_file() else "no index.html in that folder"
    return None if target.is_file() else "no such file"


def check_links(pages: list[Path], out: Path, repo_name: str) -> tuple[int, list[str]]:
    """Resolve every local reference in the pages; returns (checked, problems)."""
    checked = 0
    problems: list[str] = []
    for page in pages:
        collector = RefCollector()
        collector.feed(page.read_text(encoding="utf-8"))
        collector.close()
        for ref, line in collector.refs:
            if not is_local(ref):
                continue
            checked += 1
            why = unresolved(ref, page, out, repo_name)
            if why is not None:
                problems.append(f"{page.relative_to(out)}:{line}: {ref!r}: {why}")
    return checked, problems


def copied_documents(out: Path, generated: list[Path]) -> list[Path]:
    """The HTML documents copied from docs/, excluding the pages written here."""
    written = {p.resolve() for p in generated}
    return sorted(p for p in (out / "docs").rglob("*.html") if p.resolve() not in written)


# --------------------------------------------------------------------------- #
# The build
# --------------------------------------------------------------------------- #


def prepare_out(out_arg: str, repo: Repository) -> Path:
    out = Path(out_arg).resolve()
    for guarded in (repo.site_dir, repo.docs_dir):
        if out == guarded or guarded in out.parents:
            raise BuildError(f"--out must not be inside {guarded.relative_to(repo.root)}/")
    if out.exists():
        if not out.is_dir():
            raise BuildError(f"--out {out} is not a directory")
        if any(out.iterdir()):
            raise BuildError(f"--out {out} is not empty; pass a new or empty directory")
    else:
        out.mkdir(parents=True)
    return out


def ignore_dot_entries(directory: str, names: list[str]) -> set[str]:
    return {n for n in names if n == ".DS_Store"}


def copy_site(repo: Repository, out: Path, shell: Shell) -> list[str]:
    """Copy site/ into out, leaving out the intro and the shell; the names left out."""
    excluded = {repo.intro_file.resolve()}
    if shell.path is not None:
        excluded.add(shell.path)
    left_out: list[str] = []

    def ignore(directory: str, names: list[str]) -> set[str]:
        ignored = ignore_dot_entries(directory, names)
        here = Path(directory).resolve()
        for n in names:
            if here / n in excluded:
                ignored.add(n)
                left_out.append(str((here / n).relative_to(repo.site_dir.resolve())))
        return ignored

    if (repo.site_dir / "docs").exists():
        raise BuildError("site/docs/ would collide with the published docs/; hand-built pages go in other folders")
    if (repo.site_dir / "index.html").exists():
        raise BuildError("site/index.html would be overwritten by the generated index; the root page is the shell")
    shutil.copytree(repo.site_dir, out, ignore=ignore, dirs_exist_ok=True)
    return left_out


def stamp_pages(out: Path, tag: str) -> list[Path]:
    """Substitute the release tag into every hand-built page copied from site/."""
    pages = sorted(p for p in out.rglob("*") if p.is_file() and p.suffix.lower() == ".html")
    for page in pages:
        try:
            with page.open(encoding="utf-8", newline="") as f:
                text = f.read()
        except UnicodeDecodeError as e:
            raise BuildError(f"{page.relative_to(out)} is not UTF-8: {e}") from None
        text = text.replace(TAG_PLACEHOLDER, tag)
        survivors = [f"{page.relative_to(out)}:{text.count(chr(10), 0, m.start()) + 1}: {m.group()}" for m in SURVIVOR_RE.finditer(text)]
        if survivors:
            raise BuildError(
                f"placeholders survived the stamp (the build substitutes {TAG_PLACEHOLDER} only):\n    "
                + "\n    ".join(survivors)
            )
        with page.open("w", encoding="utf-8", newline="") as f:
            f.write(text)
    return pages


def count_files(root: Path) -> int:
    return sum(1 for p in root.rglob("*") if p.is_file())


def plural(count: int, noun: str) -> str:
    return f"{count} {noun}" if count == 1 else f"{count} {noun}s"


def build(repo: Repository, out: Path, tag: str, shell: Shell) -> None:
    print(f"{PROG}: {repo.owner}/{repo.name}, release tag {tag}")
    if not repo.docs_dir.is_dir():
        raise BuildError("no docs/ directory; nothing to publish")

    pages: list[Path] = []
    if repo.site_dir.is_dir():
        left_out = copy_site(repo, out, shell)
        pages = stamp_pages(out, tag)
        without = f" (without {', '.join(left_out)})" if left_out else ""
        print(f"  copied site/{without}")
        if pages:
            names = ", ".join(str(p.relative_to(out)) for p in pages)
            print(f"  stamped {tag} into {plural(len(pages), 'hand-built page')}: {names}")
    else:
        print("  no site/ directory; publishing docs/ alone")
    shutil.copytree(repo.docs_dir, out / "docs", ignore=ignore_dot_entries)
    print(f"  copied docs/ ({plural(count_files(out / 'docs'), 'file')})")

    untitled: list[str] = []
    root_folder = scan_folder(out / "docs", PurePosixPath("."), untitled)
    if untitled:
        raise BuildError("documents without a title:\n    " + "\n    ".join(untitled))

    intro = read_intro(repo)
    page, counts = render_page(shell, repo, tag, root_folder, intro)
    (out / "index.html").write_text(page, encoding="utf-8")
    pages.append(out / "index.html")
    summary = ", ".join(f"{key} {counts[key]}" for key, _ in GROUPS)
    intro_note = "" if intro else ", no introduction"
    print(f"  wrote index.html: {plural(len(root_folder.documents), 'document')} ({summary}){intro_note}")

    pending = list(root_folder.subfolders)
    while pending:
        folder = pending.pop(0)
        pending.extend(folder.subfolders)
        if folder.has_own_index:
            print(f"  docs/{folder.rel}/index.html ships in the repository; not generated")
            continue
        page, counts = render_page(shell, repo, tag, folder, "")
        target = out / "docs" / folder.rel / "index.html"
        target.write_text(page, encoding="utf-8")
        pages.append(target)
        print(f"  wrote docs/{folder.rel}/index.html: {plural(len(folder.documents), 'document')}")

    checked, problems = check_links(pages, out, repo.name)
    if problems:
        raise BuildError("unresolved references:\n    " + "\n    ".join(problems))
    print(
        f"  link check: {plural(checked, 'local reference')} "
        f"in {plural(len(pages), 'generated or stamped page')}, all resolve"
    )

    copied = copied_documents(out, pages)
    if copied:
        _, reported = check_links(copied, out, repo.name)
        for problem in reported:
            print(f"  warning: {problem}")
        verdict = "all resolve" if not reported else f"{len(reported)} unresolved, published as they are"
        print(f"  docs/ link check: {plural(len(copied), 'copied HTML document')}, {verdict}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog=PROG, description="Build a repository's GitHub Pages documentation site into a directory."
    )
    parser.add_argument("--out", required=True, metavar="DIR", help="a new or empty directory to build into")
    parser.add_argument(
        "--tag", metavar="vX.Y.Z", help="the release tag to pin to (default: newest v* tag reachable from HEAD)"
    )
    parser.add_argument(
        "--shell", metavar="FILE", help="the page shell, an HTML file with {{placeholders}} (default: built in)"
    )
    parser.add_argument("--repo", metavar="DIR", default=".", help="the repository to build (default: .)")
    args = parser.parse_args(argv)
    try:
        repo = repository(args.repo)
        shell = load_shell(args.shell)
        out = prepare_out(args.out, repo)
        build(repo, out, release_tag(args.tag, repo.root), shell)
    except BuildError as e:
        print(f"{PROG}: error: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
