#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Gary Frattarola <garyf@parkviewlab.ai>
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# git dev-release [--open] [--dry-run] [<major|minor|patch>]
#
# On-demand DEVELOPMENT build: a candidate for local testing, the dev counterpart
# of each of the repository's publish targets that has one (the handbook's
# releases.md, "What a release publishes"). For the real release, use `git bump` /
# `git release`, and `git back-merge` after it. It follows the repository's
# dev-release.yml as it stands on origin/develop:
#
#   - where the workflow declares the `kind` input, the build takes its version in
#     the CI workspace, from the newest release tag, the kind and the run number
#     (X.Y.Z.devN, or X.Y.Z-devN for package.json): this command dispatches it on
#     develop with that input and commits nothing;
#   - where it does not, as in a repository that has not yet switched to merge
#     commits, it sets the version file to the next dev version of the chosen
#     target, commits, pushes develop and dispatches the workflow, as before.
#
#   git dev-release patch      # a dev build heading toward the next patch
#   git dev-release minor      # ...toward the next minor (major likewise)
#   git dev-release --open     # before the switch only: open the next cycle,
#                              #   X.Y.(Z+1).dev0; no publish
#   git dev-release --dry-run patch
#
# Once a repository allows merge commits, develop takes no direct push: the open
# cycle arrives as the second commit of the back-merge pull request (`git
# back-merge`), so --open refuses there, and so does a dev build whose workflow
# lacks the `kind` input. A repository whose version is in VERSION.txt has no dev
# build and skips the open cycle. See the handbook's releases.md ("Development
# versioning") and ci.md (dev-release.yml).

set -euo pipefail

# Resolve our real directory (through the install.sh symlink) to source _sot.sh.
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
source "$(cd -P "$(dirname "$_src")" && pwd)/_sot.sh"

DRY=0; OPEN=0; KIND=""
for a in "$@"; do
  case "$a" in
    --dry-run)         DRY=1 ;;
    --open)            OPEN=1 ;;
    major|minor|patch) KIND="$a" ;;
    *) echo "git dev-release: unknown arg '$a'" >&2
       echo "usage: git dev-release [--open] [--dry-run] [<major|minor|patch>]" >&2; exit 1 ;;
  esac
done

sot_kind >/dev/null

if [[ "$(sot_kind)" == version-txt ]]; then
  echo "git dev-release: this repository's version is in VERSION.txt, so it has no dev build and skips the open cycle (the handbook's releases.md, \"Development versioning\")" >&2
  exit 1
fi

if [[ "$OPEN" == 0 && -z "$KIND" ]]; then
  echo "git dev-release: which target is this dev build heading toward?" >&2
  echo "  re-run with a kind:  git dev-release patch|minor|major" >&2
  echo "  (patch keeps the current target; minor/major re-point the cycle)" >&2
  exit 2
fi

# develop alone: the workflow is read from it. A tag fetch could fail on a local
# tag that differs from origin's, and the tags serve only the dispatch's message.
git fetch --quiet origin develop || { echo "git dev-release: cannot fetch develop from origin" >&2; exit 1; }
WF="$(git show origin/develop:.github/workflows/dev-release.yml 2>/dev/null || true)"

# Whether the workflow's workflow_dispatch trigger declares an input named `kind`.
declares_kind() {
  printf '%s\n' "$WF" | awk '
    /^[[:space:]]*(#|$)/ { next }
    /^[^[:space:]]/ { on = ($0 ~ /^["\047]?on["\047]?[[:space:]]*:/); wd = 0; inp = 0; next }
    { ind = match($0, /[^ ]/) }
    on && !wd && /^[[:space:]]+workflow_dispatch[[:space:]]*:/ { wd = 1; wdind = ind; next }
    on && wd {
      if (ind <= wdind) { wd = 0; inp = 0; next }
      if (!inp && /^[[:space:]]+inputs[[:space:]]*:/) { inp = 1; inpind = ind; child = 0; next }
      if (inp) {
        if (ind <= inpind) { inp = 0; next }
        if (child == 0) child = ind
        if (ind == child && /^[[:space:]]+["\047]?kind["\047]?[[:space:]]*:/) found = 1
      }
    }
    END { exit !found }'
}

# --- a dev build whose workflow declares the kind input: dispatch, commit nothing ---
if [[ "$OPEN" == 0 ]] && declares_kind; then
  git fetch --quiet --tags origin 2>/dev/null || echo "(the tags could not be fetched; the newest release below is the local one)"
  last="$(git tag -l 'v*' --sort=-v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -1 || true)"
  if [[ "$(sot_kind)" == pyproject ]]; then sep=".dev"; else sep="-dev"; fi
  if [[ -n "$last" ]]; then
    target="$(sot_compute_next "${last#v}" "$KIND")"
    echo "newest release: $last"
    echo "dev build:      ${target}${sep}N, computed in the workflow's workspace (N from the run); nothing is committed"
  else
    echo "no release tag yet: the workflow computes the dev version; nothing is committed"
  fi
  if [[ "$DRY" == 1 ]]; then
    echo "(dry run) would dispatch dev-release.yml on develop with kind=$KIND"
    exit 0
  fi
  gh workflow run dev-release.yml --ref develop -f kind="$KIND"
  echo "dispatched dev-release.yml on develop with kind=$KIND"
  exit 0
fi

# --- the committing paths: only in a repository that does not allow merge commits ---
origin_url="$(git remote get-url origin)"
case "$origin_url" in
  git@github.com:*)       slug="${origin_url#git@github.com:}" ;;
  https://github.com/*)   slug="${origin_url#https://github.com/}" ;;
  ssh://git@github.com/*) slug="${origin_url#ssh://git@github.com/}" ;;
  *) slug="$(gh repo view --json nameWithOwner --jq .nameWithOwner)" \
       || { echo "git dev-release: gh cannot name the repository; is gh logged in?" >&2; exit 1; } ;;
esac
slug="${slug%.git}"
allowed="$(gh api "repos/$slug" --jq .allow_merge_commit)" \
  || { echo "git dev-release: gh cannot read $slug's settings" >&2; exit 1; }
if [[ "$allowed" == true ]]; then
  if [[ "$OPEN" == 1 ]]; then
    echo "git dev-release: $slug allows merge commits, so develop takes no direct push: the open cycle arrives as the second commit of the back-merge pull request. After a release, run git back-merge." >&2
  else
    echo "git dev-release: $slug allows merge commits, so develop takes no direct push, and its dev-release.yml on origin/develop declares no kind input: re-assemble it from the handbook's dev-release parts, whose gate takes the input, and run git dev-release again." >&2
  fi
  exit 1
fi

branch="$(git rev-parse --abbrev-ref HEAD)"
if [[ "$branch" != "develop" ]]; then
  echo "git dev-release: run from develop (on '$branch')" >&2
  exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
  echo "git dev-release: working tree is dirty; commit or stash first" >&2
  exit 1
fi

cur="$(sot_read)"

if [[ "$OPEN" == 1 ]]; then
  new="$(sot_dev_version "$cur" patch)"      # next-patch placeholder
  msg="chore: open $new dev cycle"
else
  new="$(sot_dev_version "$cur" "$KIND")"
  msg="chore: dev build v$new"
fi

echo "current: $cur"
echo "new:     $new"

if [[ "$DRY" == 1 ]]; then
  if [[ "$OPEN" == 1 ]]; then
    echo "(dry run) would set SoT -> $new, commit \"$msg\", push develop (no publish)"
  else
    echo "(dry run) would set SoT -> $new, commit \"$msg\", push develop, dispatch dev-release.yml"
  fi
  exit 0
fi

# shellcheck disable=SC2046  # intentional word-split: sot_write may echo two files
git add $(sot_write "$new")
git commit -m "$msg" >/dev/null
git push origin develop

if [[ "$OPEN" == 1 ]]; then
  echo "opened dev cycle at $new (pushed develop). No publish."
else
  if gh workflow run dev-release.yml --ref develop; then
    echo "dev build $new pushed; dispatched dev-release.yml on develop."
  else
    echo "dev build $new pushed, but couldn't dispatch dev-release.yml — is it on develop?" >&2
  fi
fi
